{
  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/fastfetch-logo.jpg",
    "width": 63,
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "display": {
    "separator": " ─ ",
    "color": {
      "separator": "blue"
    }
  },
  "modules": [
    "break",
    "title",
    "break",
    {
      "type": "custom",
      "format": "╭─ System"
    },
    {
      "type": "os",
      "key": "├  OS",
      "keyColor": "blue",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "key": "├ 󰒋 Kernel",
      "keyColor": "blue"
    },
    {
      "type": "de",
      "key": "├ 󰧨 DE",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": "├ 󱆃 Shell",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "├ 󰆍 Terminal",
      "keyColor": "blue"
    },
    {
      "type": "media",
      "key": "└ 󰝚 Music",
      "keyColor": "blue"
    },
    "break",
    {
      "type": "custom",
      "format": "╭─ Hardware"
    },
    {
      "type": "cpu",
      "key": "├ 󰍛 CPU",
      "keyColor": "cyan",
      "format": "{name} @ {freq-max}{?temperature} - {temperature}{?}",
      "temp": true
    },
    {
      "type": "gpu",
      "key": "├ 󰢮 GPU",
      "keyColor": "cyan",
      "temp": true
    },
    {
      "type": "memory",
      "key": "├ 󰑭 RAM",
      "keyColor": "cyan"
    },
    {
      "type": "disk",
      "key": "└ 󰋊 Disk",
      "keyColor": "cyan"
    },
    "break",
    {
      "type": "custom",
      "format": "╭─ Uptime / Age"
    },
    {
      "type": "uptime",
      "key": "├ 󰔚 Uptime",
      "keyColor": "blue"
    },
    {
      "type": "command",
      "key": "└ 󰋚 OS Age",
      "keyColor": "blue",
      "text": "birth=$(stat -c %W /etc/machine-id 2>/dev/null); [ \"${birth:-0}\" -le 0 ] 2>/dev/null && birth=$(stat -c %W / 2>/dev/null); [ \"${birth:-0}\" -le 0 ] 2>/dev/null && birth=$(date +%s); now=$(date +%s); age=$((now-birth)); [ \"$age\" -lt 0 ] && age=0; d=$((age/86400)); h=$(((age%86400)/3600)); m=$(((age%3600)/60)); if [ \"$d\" -gt 0 ]; then echo \"$d days, $h hours\"; elif [ \"$h\" -gt 0 ]; then echo \"$h hours, $m mins\"; else echo \"$m mins\"; fi"
    },
    "break",
    {
      "type": "colors"
    }
  ]
}
